<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout style="@style/PageContent">
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/currentInput" style="@style/InputField" android:hint="@string/current_password" app:endIconMode="password_toggle">
      <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLength="200" android:saveEnabled="false" android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/newInput" style="@style/InputField" android:hint="@string/new_password" app:endIconMode="password_toggle" app:helperText="@string/password_help">
      <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLength="200" android:saveEnabled="false" android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmInput" style="@style/InputField" android:hint="@string/confirm_password" app:endIconMode="password_toggle">
      <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLength="200" android:saveEnabled="false" android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
  </LinearLayout>
</ScrollView>