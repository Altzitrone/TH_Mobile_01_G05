<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="6dp" app:cardCornerRadius="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/title" style="@style/SectionLabel" android:text="@string/student_code" android:layout_marginTop="0dp" android:layout_marginBottom="4dp" />
    <TextView android:id="@+id/subtitle" style="@style/PageBody" android:text="@string/fullname" android:textColor="?attr/colorPrimary" />
    <TextView android:id="@+id/body" style="@style/PageBody" android:text="@string/email" android:layout_marginTop="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end">
      <com.google.android.material.button.MaterialButton android:id="@+id/viewButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="64dp" android:text="@string/view" />
      <com.google.android.material.button.MaterialButton android:id="@+id/editButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="64dp" android:text="@string/edit" />
      <com.google.android.material.button.MaterialButton android:id="@+id/deleteButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="64dp" android:text="@string/delete" android:textColor="?attr/colorError" />
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>